# The Pokémon Champions ranked regulation mondex is up to date with, shown in the app and index.html.
# Regulation Set M-C runs from 9 September to 2 December 2026.
VITE_REGULATION=M-C

# Vue's per-component init/render/patch timings in the browser's Performance panel (dev server only). They show
# which components re-render and how often, but inflate durations a lot, so they're off by default: `just dev-profile`
# switches them on for one run, or set VITE_PROFILE=true in a gitignored .env.local.
VITE_PROFILE=false
